# ============================================================
# LendMate environment variables
# Copy to .env (local) or set in your host's dashboard (Render, VPS).
# Every value below is a PLACEHOLDER. Replace it. Never commit .env.
# ============================================================

# --- Django core -------------------------------------------
# Generate a real key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Render adds its own hostname automatically (RENDER_EXTERNAL_HOSTNAME).
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
ALLOW_SELF_REGISTRATION=false

# --- HTTPS / proxy (production) ----------------------------
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- Login throttling and sessions -------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_AGE=43200

# --- PostgreSQL ---------------------------------------------
# Local / docker-compose: set the POSTGRES_* values.
# Render: set DATABASE_URL to the Render Postgres connection string instead.
# If a password contains special characters, percent-encode it in DATABASE_URL
# (for example  p@ss/word  becomes  p%40ss%2Fword).
POSTGRES_DB=lendmate
POSTGRES_USER=lendmate
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=
# require = TLS on (hosted databases); prefer = TLS if available (local); disable = off
DB_SSLMODE=prefer

# --- Redis / Celery ----------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Reminder schedule -------------------------------------------
# Days before the due date that the borrower and lender get an upcoming email.
REMINDER_UPCOMING_DAYS=5
# Overdue reminders repeat every N days after the first one. 0 = send once only.
REMINDER_OVERDUE_REPEAT_DAYS=7
# Stop overdue reminders this many days after the due date.
REMINDER_OVERDUE_LOOKBACK_DAYS=30
# Daily send times, HH:MM in the project time zone (Asia/Kolkata).
REMINDER_UPCOMING_TIME=09:00
REMINDER_OVERDUE_TIME=10:00

# --- Email notifications ---------------------------------------
# Borrower emails go through Django's mail backend, configured in the Email section below.
# Emails are only sent to borrowers who have consented and have an address on file.

# --- Email (password reset) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=LendMate <no-reply@yourdomain.com>
